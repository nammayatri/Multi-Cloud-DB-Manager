# Dual Database Manager - Kubernetes Secret (example)
#
# 1. Copy this file to secrets.yaml:
#    cp secrets.yaml.example secrets.yaml
# 2. Replace all placeholders in secrets.yaml with your real values.
# 3. Do NOT commit secrets.yaml (it is in .gitignore).
#
# DATABASE_CONFIGS and REDIS_CONFIGS must be base64-encoded JSON.
# To generate: echo -n '<json>' | base64
# To decode:   echo '<base64>' | base64 -d
#
apiVersion: v1
kind: Secret
metadata:
  name: dual-db-secrets
  namespace: <NAMESPACE>   # Replace with your namespace (e.g. default, dual-db-manager)
  labels:
    app: dual-db-manager
type: Opaque
stringData:
  # ──────────────────────────────────────────────────────────────────────────
  # DATABASE_CONFIGS — base64-encoded JSON
  # ──────────────────────────────────────────────────────────────────────────
  # Decoded structure:
  # {
  #   "primary": {
  #     "cloudName": "cloud1",
  #     "db_configs": [
  #       {
  #         "name": "db1",
  #         "label": "Primary DB",
  #         "host": "YOUR_DB_HOST",
  #         "port": 5432,
  #         "user": "YOUR_DB_USER",
  #         "password": "YOUR_DB_PASSWORD",
  #         "database": "YOUR_DB_NAME",
  #         "schemas": ["public", "app_schema"],
  #         "defaultSchema": "public",
  #         "publicationName": "my_publication"       <-- optional, for logical replication
  #       }
  #     ]
  #   },
  #   "secondary": [
  #     {
  #       "cloudName": "cloud2",
  #       "db_configs": [
  #         {
  #           "name": "db1",
  #           "label": "Primary DB",
  #           "host": "YOUR_SECONDARY_DB_HOST",
  #           "port": 5432,
  #           "user": "YOUR_DB_USER",
  #           "password": "YOUR_DB_PASSWORD",
  #           "database": "YOUR_DB_NAME",
  #           "schemas": ["public", "app_schema"],
  #           "defaultSchema": "public",
  #           "subscriptionName": "my_subscription"   <-- optional, for logical replication
  #         }
  #       ]
  #     }
  #   ],
  #   "history": {
  #     "host": "YOUR_HISTORY_DB_HOST",
  #     "port": 5432,
  #     "user": "YOUR_HISTORY_DB_USER",
  #     "password": "YOUR_HISTORY_DB_PASSWORD",
  #     "database": "YOUR_HISTORY_DB_NAME"
  #   },
  #   "slack": {                                      <-- optional, for replication alerts
  #     "botToken": "xoxb-YOUR-SLACK-BOT-TOKEN",
  #     "channels": ["#replication-alerts"]
  #   },
  #   "readReplicas": {                               <-- optional, for Migration Verifier
  #     "environments": {
  #       "prod": {
  #         "label": "Production",
  #         "databases": [
  #           {
  #             "name": "BPP",
  #             "label": "Driver (BPP)",
  #             "host": "YOUR_READ_REPLICA_HOST",
  #             "port": 5432,
  #             "user": "YOUR_READER_USER",
  #             "password": "YOUR_READER_PASSWORD",
  #             "database": "YOUR_DB_NAME",
  #             "defaultSchema": "your_schema"
  #           }
  #         ]
  #       }
  #     }
  #   },
  #   "migrations": {                                 <-- optional, for Migration Verifier
  #     "repoPath": "/repos/nammayatri",
  #     "pathMapping": [
  #       { "path": "Backend/dev/migrations/app-name", "database": "BPP", "defaultSchema": "your_schema", "label": "Migrations" },
  #       { "path": "Backend/dev/migrations-read-only/app-name", "database": "BPP", "defaultSchema": "your_schema", "label": "Schema (Read-Only)" }
  #     ]
  #   }
  # }
  #
  # Supports ${VAR_NAME} placeholders in JSON values — they are substituted
  # at startup from environment variables or Kubernetes secrets (${SECRET:name:key}).
  #
  DATABASE_CONFIGS: |
    

  # ──────────────────────────────────────────────────────────────────────────
  # REDIS_CONFIGS — base64-encoded JSON (required for Redis Manager feature)
  # ──────────────────────────────────────────────────────────────────────────
  # Decoded structure:
  # {
  #   "primary": {
  #     "cloudName": "cloud1",
  #     "host": "YOUR_REDIS_HOST",
  #     "port": 6379
  #   },
  #   "secondary": [
  #     {
  #       "cloudName": "cloud2",
  #       "host": "YOUR_SECONDARY_REDIS_HOST",
  #       "port": 6379
  #     }
  #   ]
  # }
  #
  # If omitted, Redis Manager feature will be disabled (DB Manager still works).
  #
  REDIS_CONFIGS: |
    eyJwcmltYXJ5Ijp7ImNsb3VkTmFtZSI6InByaW1hcnkiLCJob3N0IjoiWU9VUl9SRURJU19IT1NUIiwicG9ydCI6NjM3OX0sInNlY29uZGFyeSI6W119

  # ──────────────────────────────────────────────────────────────────────────
  # Session secret — use a long random string in production
  # Generate: openssl rand -hex 32
  # ──────────────────────────────────────────────────────────────────────────
  SESSION_SECRET: "REPLACE_WITH_LONG_RANDOM_SESSION_SECRET"

  # ──────────────────────────────────────────────────────────────────────────
  # PASSETTO_KEYS — plain JSON (NOT base64-encoded — unlike DATABASE_CONFIGS/
  # REDIS_CONFIGS above, this is read as-is; only standard k8s Secret base64
  # applies). Optional — enables Config Sync's patch step to re-encrypt
  # values locally via PyNaCl, with no Postgres `test_dashboard_<env>`
  # database, no vendored passetto-server binary, and no MASTER_PASSWORD
  # needed. Same shape as the real app's own passetto-lib env var
  # (Backend/lib/passetto-lib/src/Passetto/Lib.hs's `getEnv "PASSETTO_KEYS"`):
  # {
  #   "activeKeyId": 1,
  #   "keys": [
  #     { "id": 1, "secretKey": "<base64 32-byte NaCl box secret key>", "publicKey": "<base64 32-byte NaCl box public key>" }
  #   ]
  # }
  # Generate a fresh keypair with PyNaCl:
  #   python3 -c "import nacl.public,base64; sk=nacl.public.PrivateKey.generate(); print('secretKey:', base64.b64encode(bytes(sk)).decode()); print('publicKey:', base64.b64encode(bytes(sk.public_key)).decode())"
  # If omitted, Config Sync's patch step falls back to the old
  # passetto-server-binary + test_dashboard_<env> Postgres setup.
  # ──────────────────────────────────────────────────────────────────────────
  PASSETTO_KEYS: |
    {"activeKeyId":1,"keys":[{"id":1,"secretKey":"REPLACE_WITH_BASE64_SECRET_KEY","publicKey":"REPLACE_WITH_BASE64_PUBLIC_KEY"}]}
